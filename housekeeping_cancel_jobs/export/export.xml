-- *********************************
select eh_name, eh_ah_idnr
from eh
where eh_status in (1560, 1563)
and eh_client = ?
and to_char(EH_ActivationTime, 'YYYYMMDD') &lt; ?
and eh_otype in ('JOBS','JOBP','JOBF','SCRI','EVNT')
order by 
    case 
       when eh_starttype = '&lt;JSCH&gt;' then '001' 
       when eh_starttype = '&lt;ONCE&gt;' then '002'
       when eh_starttype is null then '003' 
